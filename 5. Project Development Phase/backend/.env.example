PORT=5000
SECRET_KEY=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers (set one or more; LLM_PROVIDER=auto picks Groq then OpenAI then HF then Ollama)
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Local SQLite when Supabase keys are empty
DATABASE_PATH=./database/app.db
